# ─────────────────────────────────────────────────────────────────────────────
# Task Capture & Reminder System — environment configuration
# Copy to `.env` and fill in. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (single-file SQLite, trivial to back up) ---
DATABASE_URL="file:./dev.db"

# --- Anthropic API (natural-language task parsing) ---
ANTHROPIC_API_KEY="sk-ant-..."
# Optional override; defaults to a current Sonnet model.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Outbound email (reminders + .ics calendar invites) via SMTP/nodemailer ---
# Use a DEDICATED Gmail with an App Password, or a provider like Resend/Postmark.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"            # true for port 465, false for 587 (STARTTLS)
SMTP_USER="yourtasks@gmail.com"
SMTP_PASS="your-app-password"

# Address the system sends FROM (the dedicated sender / calendar organizer).
SENDER_EMAIL="yourtasks@gmail.com"

# Where reminders + error alerts are delivered (usually your personal inbox).
NOTIFY_EMAIL="you@personal.com"

# Your WORK email — the calendar invite ATTENDEE. The system never logs into it.
WORK_EMAIL="you@work.com"

# --- Inbound email ingestion (IMAP) — the dedicated task inbox ---
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER="yourtasks@gmail.com"
IMAP_PASS="your-app-password"
# The mailbox/folder to poll.
IMAP_MAILBOX="INBOX"

# Address users forward/send tasks to (informational; usually == IMAP_USER).
INGEST_EMAIL="yourtasks@gmail.com"

# --- Calendar invite UID domain (stable per-task UIDs for Outlook) ---
CALENDAR_UID_DOMAIN="yourtasks.local"

# --- Worker toggles (the cron process reads these) ---
# Set to "false" to disable a job without removing it.
ENABLE_EMAIL_POLL="true"
ENABLE_REMINDERS="true"
ENABLE_BACKUP="true"

# Where the worker can reach the Next.js app for triggering enrichment of
# email-ingested tasks (the worker calls the same parser directly, so this is
# only used if you split processes onto different hosts). Optional.
APP_BASE_URL="http://localhost:3000"
