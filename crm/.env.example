# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────

# ── Database ──
# Must match docker-compose.yml. Host is 127.0.0.1 (localhost only).
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_dev_pw
POSTGRES_DB=crm
DATABASE_URL="postgresql://crm:crm_local_dev_pw@127.0.0.1:5432/crm?schema=public"

# ── Session / auth ──
# Generate a strong value:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# ── First login (used ONLY by `npm run db:seed` to create your account) ──
# After first login you can change these; the seed will not overwrite an
# existing user. Choose a strong password.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Sales"

# ── Claude bridge (Phase 2) ──
# Token your local MCP server / Claude uses to POST into the CRM intake API.
# Generate:  openssl rand -hex 32
INTAKE_API_TOKEN=""
# Where the bundled MCP server reaches the running CRM:
CRM_BASE_URL="http://localhost:3000"

# ── Anthropic API (Phase 2: signature parsing + note summaries) ──
# Heads-up: email bodies & notes are sent to Anthropic for parsing/summarizing.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── Email intake (Phase 2: IMAP) ──
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""

# ── Auto inventory feed (backlog) ──
# Folder the worker watches for inventory CSV drops / a scheduled DMS export.
# Defaults to crm/inventory-feed. Leave blank to use the default.
INVENTORY_FEED_DIR=""

# ── Dealer inventory sync (Northwest Lexus) ──
# Refreshes new + pre-owned stock from northwestlexus.com via the Python scraper.
# Only works from your home network (Cloudflare blocks datacentres) + needs python3.
# Optional: override the python interpreter.
PYTHON_BIN="python3"
# Optional: absolute path to data/inventory.json (defaults to ../data/inventory.json).
INVENTORY_SNAPSHOT=""

# ── Remote access (Tailscale) ──
# MagicDNS hostname(s) you'll reach the app at over your tailnet, comma-separated,
# e.g. "macmini.tailXXXX.ts.net". Required for login/forms to work remotely. The
# app still binds to localhost — Tailscale Serve proxies it in privately.
REMOTE_HOSTNAMES=""

# Background worker schedules (cron).
POLL_CRON="*/5 * * * *"     # email poll
RESCAN_CRON="*/15 * * * *"  # Want↔Vehicle match re-scan
FEED_CRON="*/10 * * * *"    # inventory feed (watched-folder CSV import)
DEALER_SYNC_CRON=""         # dealer web scrape, e.g. "0 7 * * *"; empty = off
DIGEST_CRON="0 8 * * *"     # daily digest (08:00)
